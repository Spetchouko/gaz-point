# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env` puis renseignez les valeurs réelles.
# Ne committez jamais `.env` (déjà ignoré par git).
# ---------------------------------------------------------------------------

# Base de données Neon (obligatoire au runtime)
DATABASE_URL=

# Better Auth (obligatoire en production)
# Générer un secret : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique utilisée par Better Auth (ex. https://www.gazpoints.com)
BETTER_AUTH_URL=
# URL publique du site (liens des emails, métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (optionnel, connexion via Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi d'emails via Gmail SMTP (obligatoire pour l'inscription par OTP)
# Deux conventions supportées (la première trouvée est utilisée) :
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Ou alternativement :
# EMAIL_USER=
# EMAIL_PASS=

# Adresse de réception du formulaire de contact
CONTACT_EMAIL=gazpoints@gmail.com

# Protection du cron de planification marketing
CRON_SECRET=
